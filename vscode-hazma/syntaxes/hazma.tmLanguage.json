{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HAZMA",
  "scopeName": "source.hazma",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#boolean-names"
    },
    {
      "include": "#const"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#stray-is"
    },
    {
      "include": "#round"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hazma",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hazma",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hazma",
              "match": "\\\\(n|t|\"|\\\\)"
            },
            {
              "name": "invalid.illegal.escape.hazma",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.hazma",
          "match": "(?<!\\w)\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "boolean-names": {
      "patterns": [
        {
          "name": "variable.other.boolean.hazma",
          "match": "\\bis(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+\\b"
        }
      ]
    },
    "const": {
      "patterns": [
        {
          "name": "storage.modifier.const.hazma",
          "match": "const\\."
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "keyword.control.hazma",
          "match": "\\b(?:t\\.change|s\\.change|log\\.out|struct\\.c|struct\\.base|func\\.p|func\\.c|func\\.r|repeat\\.break|repeat\\.continue|repeat\\.new|l\\.save|l\\.add|l\\.remove|l\\.change|l\\.count|l\\.find\\.index|l\\.find|save|change|repeat|func|struct|if|else|till|default)\\b"
        },
        {
          "name": "keyword.operator.logical.hazma",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.hazma",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "stray-is": {
      "patterns": [
        {
          "name": "invalid.illegal.hazma",
          "match": "\\bis\\b(?![a-zA-Z0-9_.])"
        }
      ]
    },
    "round": {
      "patterns": [
        {
          "name": "keyword.operator.round.hazma",
          "match": "(?<=[\\w\\)])\\.r\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.hazma",
          "match": "==|!=|>=|<="
        },
        {
          "name": "keyword.operator.hazma",
          "match": "[=<>+\\-*/]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.hazma",
          "match": ":|,"
        },
        {
          "name": "punctuation.section.braces.hazma",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.hazma",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.hazma",
          "match": "[\\[\\]]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.hazma",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*\\b"
        }
      ]
    }
  }
}
